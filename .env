# LLM Configuration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-test-placeholder
OPENAI_API_KEY=sk-test-placeholder

# Ollama SLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@gmail.com
SMTP_PASSWORD=test_password
ALERT_EMAIL_TO=alerts@example.com

# Monitoring Targets
MONITOR_DOMAINS=github.com,google.com

# Monitoring Intervals (seconds)
DEVICE_CHECK_INTERVAL=30
WEBSITE_CHECK_INTERVAL=60

# Escalation Thresholds
SLM_CRITICAL_CONFIDENCE_THRESHOLD=0.75
CONSECUTIVE_WARNINGS_BEFORE_ALERT=3
ALERT_STORM_WINDOW_MINUTES=10
ALERT_STORM_MAX_ALERTS=3

# Database
DATABASE_URL=sqlite:///./monitor.db

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_store
