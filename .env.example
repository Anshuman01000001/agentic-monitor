# LLM Configuration
# Provider options: ollama | minmax | openai | anthropic
LLM_PROVIDER=ollama
MINIMAX_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-3.0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama SLM Configuration (used for classification, and for alerts when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
SLM_MODEL=phi3
LLM_MODEL=phi3

# Email Configuration (Gmail: use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
ALERT_EMAIL_TO=you@example.com

# Monitoring Targets
MONITOR_DOMAINS=github.com,google.com

# Monitoring Intervals (seconds)
DEVICE_CHECK_INTERVAL=30
WEBSITE_CHECK_INTERVAL=60

# Escalation Thresholds
SLM_CRITICAL_CONFIDENCE_THRESHOLD=0.75
CONSECUTIVE_WARNINGS_BEFORE_ALERT=3
ALERT_STORM_WINDOW_MINUTES=10
ALERT_STORM_MAX_ALERTS=3

# Database
DATABASE_URL=sqlite:///./monitor.db

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_store
